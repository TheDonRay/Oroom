# Copy to .env and fill in. Never commit .env.
# These are the variables config/env.js validates at startup.

# Core
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173       # frontend origin, used for CORS

# MongoDB (Atlas → Connect → Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB_NAME=oroom

# Clerk (dashboard → Configure → API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk → Configure → Webhooks → your endpoint → Signing Secret.
# Optional at startup; /webhooks/clerk returns 500 until it's set.
# Local dev: point the endpoint at an ngrok URL, e.g. https://<your-domain>.ngrok-free.dev/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
